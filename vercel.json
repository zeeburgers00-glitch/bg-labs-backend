{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/.*",
      "dest": "main.py"
    },
    {
      "src": "/(health|keep-alive|docs|redoc|openapi\\.json)",
      "dest": "main.py"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/favicon\\.ico",
      "dest": "/index.html",
      "status": 204
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "env": {
    "PYTHON_VERSION": "3.11",
    "PYTHONUNBUFFERED": "1"
  },
  "regions": ["iad1"],
  "github": {
    "silent": true
  }
}

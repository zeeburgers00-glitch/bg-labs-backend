# Template only. Never put real keys in this file or commit .env files.
# Vercel stores actual values as Sensitive environment variables; redeploy after changes.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Deny by default. Add specific Supabase Auth user UUIDs (comma-separated),
# or explicitly opt in to all authenticated users of the shared project.
VIMAX_AI_ALLOWED_USER_IDS=
VIMAX_AI_ALLOW_ALL_AUTHENTICATED=false

# Add only rotated keys you intend to use. All calls are server-side.
GROQ_API_KEY=
GROQ_MODELS=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash
MISTRAL_API_KEY=
MISTRAL_MODELS=mistral-small-latest
ZAI_API_KEY=
ZAI_MODELS=glm-4.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/free
HF_TOKEN=
HF_MODELS=openai/gpt-oss-120b:groq
OPENCODE_API_KEY=
# Explicitly required; only documented paid chat-completions models are allowed.
OPENCODE_MODELS=
PEXELS_API_KEY=

# Hacker AI is not connected: its private API endpoint must be independently
# verified before an adapter can be safely enabled. No YouTube OAuth/upload or
# cloud rendering credentials are implemented by this template.

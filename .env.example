# Template only. Never put real keys in this file or commit .env files.
# Vercel stores actual values as Sensitive environment variables; redeploy after changes.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional Google app sign-in: first confirm existing emails and configure the
# shared Supabase Google provider and exact redirect allowlist. Off by default.
# See docs/google-signin.md. This does not authorize any Google service.
VIMAX_GOOGLE_SIGNIN_ENABLED=false
VIMAX_GOOGLE_SIGNIN_REDIRECT_URI=

# Deny by default. Add specific Supabase Auth user UUIDs (comma-separated),
# or explicitly opt in to all authenticated users of the shared project.
VIMAX_AI_ALLOWED_USER_IDS=
VIMAX_AI_ALLOW_ALL_AUTHENTICATED=false

# Optional text-only, fixed free route via Vercel OIDC; off by default.
# Review BYOK, add-ons, privacy and provider limitations before enabling.
# See docs/free-ai-gateway.md. No token belongs in this template.
VIMAX_GATEWAY_FREE_ENABLED=false

# Add only rotated keys you intend to use. All calls are server-side.
OPENAI_API_KEY=
# OpenAI chat-completions model; availability and pricing vary by account.
OPENAI_MODELS=gpt-5.4-mini,gpt-5.4
GROQ_API_KEY=
# Groq retired llama-3.1-8b-instant; model access depends on account tier.
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
GEMINI_API_KEY=
# Prefer current Flash for new projects; 2.5 availability may be restricted.
GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-flash,gemini-4-argon
MISTRAL_API_KEY=
MISTRAL_MODELS=mistral-small-latest
ZAI_API_KEY=
# These are listed as free by Z.ai; verify current prices and account access.
ZAI_MODELS=glm-4.7-flash,glm-4.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/free
HF_TOKEN=
HF_MODELS=openai/gpt-oss-120b:groq
OPENCODE_API_KEY=
# Explicitly required; only documented paid chat-completions models are allowed.
OPENCODE_MODELS=
PEXELS_API_KEY=

# Optional read-only public YouTube channel metadata sample. Off by default;
# each approved lookup reserves a shared attempt and uses up to three API quota
# units. Enable the YouTube Data API in a project you control and store a
# restricted API key as a Vercel Sensitive variable. This is not channel OAuth.
VIMAX_YOUTUBE_PUBLIC_RESEARCH_ENABLED=false
YOUTUBE_PUBLIC_DATA_API_KEY=

# Hacker AI is not connected: its private API endpoint must be independently
# verified before an adapter can be safely enabled. No Gmail/private-GitHub
# account connection is implemented by this template.

# Optional paid Runpod P-Video preview. OFF until explicitly configured and
# enabled; also requires the separate database allowlist. Never put real keys
# in this file. See docs/gpu-preview.md for cost, privacy and setup limitations.
VIMAX_GPU_ENABLED=false
VIMAX_GPU_ALLOWED_USER_IDS=
RUNPOD_API_KEY=
# Independent random 32-byte key, 64 hexadecimal digits, stored as Sensitive.
VIMAX_GPU_TOKEN_KEY=

# Optional manual, PRIVATE YouTube upload. Requires the separate DB allowlist,
# Google OAuth consent and setup in docs/youtube-upload.md. Never paste secrets
# into chat, Git or browser code; put a ROTATED client secret and an independently
# generated random 32-byte hex key in Vercel Sensitive variables instead.
VIMAX_YOUTUBE_CLIENT_ID=
VIMAX_YOUTUBE_CLIENT_SECRET=
VIMAX_YOUTUBE_TOKEN_KEY=
VIMAX_YOUTUBE_REDIRECT_URI=
VIMAX_YOUTUBE_ALLOWED_USER_IDS=
# Optional read-only Analytics API/chart in chat. Requires an additive
# migration and separate Google permission. See docs/youtube-analytics.md.
VIMAX_YOUTUBE_ANALYTICS_ENABLED=false

# Optional TikTok profile and Facebook Page connections. Each requires its own
# registered developer app, exact HTTPS callback, consent, database allowlist,
# and approval where required. These connections cannot post videos.
# See docs/social-connections.md. Store secrets only in Vercel Sensitive vars.
VIMAX_SOCIAL_ALLOWED_USER_IDS=
# Independent random 32-byte/64-hex key; do not reuse the YouTube key.
VIMAX_SOCIAL_TOKEN_KEY=
VIMAX_TIKTOK_CLIENT_KEY=
VIMAX_TIKTOK_CLIENT_SECRET=
VIMAX_TIKTOK_REDIRECT_URI=
VIMAX_FACEBOOK_APP_ID=
VIMAX_FACEBOOK_APP_SECRET=
VIMAX_FACEBOOK_REDIRECT_URI=

# Planning worker ONLY: set these in the separately hosted worker's private
# secret manager, not in browser code or Vercel's public frontend. This worker
# signs in as this account and can act with that account's normal permissions.
VIMAX_WORKER_EMAIL=
VIMAX_WORKER_PASSWORD=
VIMAX_WORKER_OWNER_ID=
VIMAX_WORKER_CONCURRENCY=1
# It also needs SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY and a rotated provider
# key/model allowlist above, supplied in that worker environment independently.

# BG LABS Backend - Environment Variables
# Copy this to .env and fill in the values

# ============================================================
# DATABASE (Neon PostgreSQL - Free 3GB)
# ============================================================
# Format: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/bg_labs

# ============================================================
# SECURITY
# ============================================================
SECRET_KEY=your-super-secret-key-change-this-to-random-string

# Optional hosted talking-avatar + custom voice generation (keep secret)
FAL_KEY=

# ============================================================
# SERVER
# ============================================================
PORT=7860

# ============================================================
# DEPLOYMENT (Render auto-sets these)
# ============================================================
# RENDER_EXTERNAL_URL=https://your-app.onrender.com

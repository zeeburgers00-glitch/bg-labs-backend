# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bg_labs

# Security
SECRET_KEY=your-super-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Debug mode (set to false in production)
DEBUG=true

# Redis (optional)
REDIS_URL=redis://localhost:6379

# TTS Settings
TTS_MODEL=xtts_v2
TTS_DEVICE=auto
MAX_TEXT_LENGTH=10000
DEFAULT_LANGUAGE=en

# Storage
STORAGE_DIR=storage
MAX_UPLOAD_SIZE=52428800
